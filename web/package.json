{
  "name": "pdf-unit-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm typecheck && vite build",
    "check": "pnpm typecheck && ultracite check && vitest run",
    "dev": "vite",
    "e2e": "playwright test",
    "e2e:build": "vite build --mode e2e",
    "e2e:parity": "PARITY=1 playwright test",
    "fix": "ultracite fix",
    "lint": "ultracite check",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "daisyui": "5.7.42",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "packageManager": "pnpm@12.5.1"
}
